[Unit]
Description=gelato-blog — статьи для новичков по X-сводке -> main -> деплой -> Telegram
After=network-online.target
OnFailure=claude-notify-fail@%p.service

[Service]
Type=oneshot
User=painsearchdev
WorkingDirectory=/home/painsearchdev/gelato-blog
ExecStart=/home/painsearchdev/gelato-blog/run.sh
StandardOutput=journal
StandardError=journal
TimeoutStartSec=5400
