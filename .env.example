NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_BASE64=   # base64 от service-account.json
NEXT_PUBLIC_USE_FIREBASE_EMULATOR= # 1 = локальная разработка на эмуляторах
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
PAYMENT_WEBHOOK_SECRET=
FIREBASE_STORAGE_BUCKET=           # бакет для загрузки превью; по умолчанию <projectId>.firebasestorage.app
OPENROUTER_API_KEY=                # ключ OpenRouter для авто-оформления материалов
OPENROUTER_MODEL=                  # модель (по умолчанию anthropic/claude-haiku-4.5)
YOUTUBE_API_KEY=                   # необязательно: точная длительность видео через YouTube Data API
CRON_SECRET=                       # секрет для cron-снятия истёкших доступов на Vercel
